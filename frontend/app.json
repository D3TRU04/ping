{
  "expo": {
    "name": "Ping",
    "slug": "Ping",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justaaron.pingapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icons/logo1.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.justaaron.pingapp",
      "userInterfaceStyle": "automatic"
    },
    "web": {},
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "ping",
    "deepLinking": true,
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "cdf59105-a24c-4798-8c26-dec0e23218ec"
      }
    }
  }
}
