{
  "expo": {
    "name": "Ping",
    "slug": "Ping",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justaaron.pingapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"

    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.justaaron.pingapp",
      "userInterfaceStyle": "automatic"
    },
    "web": {},
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "ping",
    "deepLinking": true,
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "supabaseUrl": "YOUR_SUPABASE_URL_HERE",
      "supabaseAnonKey": "YOUR_SUPABASE_ANON_KEY_HERE",
      "eas": {
        "projectId": "380f0e77-6b1a-42f2-b403-aafafcbf5417"
      }
    }
  }
}
