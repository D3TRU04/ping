//  AppConfig.swift.example
//  PingNative
//
//  Configuration template file
//  Copy this file to AppConfig.swift and add your actual API keys
//

import Foundation

/// Configuration manager that loads secrets from Info.plist or Config.plist
///
/// IMPORTANT: Do not commit real secrets to source control.
///
/// SETUP INSTRUCTIONS:
/// 1. Copy this file to AppConfig.swift (remove .example extension)
/// 2. Replace the placeholder values below with your actual API keys
/// 3. AppConfig.swift is gitignored and will not be committed
struct AppConfig {
    let mapboxAccessToken: String

    /// Loads configuration from Info.plist
    /// Falls back to placeholder values if keys are missing
    static func load() -> AppConfig {
        guard let path = Bundle.main.path(forResource: "Info", ofType: "plist"),
              let plist = NSDictionary(contentsOfFile: path) else {
            // Fallback to placeholder values if Info.plist not found
            return AppConfig(
                mapboxAccessToken: "YOUR_MAPBOX_ACCESS_TOKEN"
            )
        }

        let mapboxAccessToken = plist["MAPBOX_ACCESS_TOKEN"] as? String ?? "YOUR_MAPBOX_ACCESS_TOKEN"

        return AppConfig(
            mapboxAccessToken: mapboxAccessToken
        )
    }

    /// Validates that configuration values are not placeholders
    var isValid: Bool {
        return !mapboxAccessToken.contains("YOUR_")
    }
}
